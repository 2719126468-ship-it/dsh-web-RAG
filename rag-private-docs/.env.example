# Required: model provider
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# Qdrant (local by default)
QDRANT_PATH=./qdrant_data
COLLECTION_NAME=private_docs
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# API security
# Generate independent random values; never reuse the model provider key.
# API_AUTH_TOKEN protects /query.
# API_ADMIN_TOKEN protects /index and destructive force reindex.
# API_HOST defaults to 127.0.0.1. Expose it only behind a trusted TLS proxy.
# API_AUTH_TOKEN=replace-with-a-long-random-token
# API_ADMIN_TOKEN=replace-with-a-different-long-random-token
# API_HOST=127.0.0.1
# API_PORT=8000

# Optional integrations
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# WEBHOOK_URL=
