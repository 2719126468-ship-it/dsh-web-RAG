# ============ 必填：DeepSeek API ============
# 获取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============ Embedding 模型（HuggingFace 本地，无需 key）============
# 换模型时务必同步修改 EMBEDDING_DIM：
#   bge-small-zh-v1.5  -> 512
#   bge-base-zh-v1.5   -> 768
#   bge-large-zh-v1.5  -> 1024
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ============ Qdrant ============
# 默认：本地嵌入式模式，数据存 qdrant_data/
QDRANT_PATH=./qdrant_data
COLLECTION_NAME=private_docs

# 可选：远程 server 模式（数据点 > 20000 时建议启用）
# 改 QDRANT_MODE=server 并填好下面两项
# QDRANT_MODE=local
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ============ 可选：Notion 同步 ============
# NOTION_API_KEY=secret_xxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxx
